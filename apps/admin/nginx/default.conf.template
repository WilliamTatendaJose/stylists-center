# Railway assigns the listen port at runtime via $PORT — the base nginx:alpine
# image's docker-entrypoint.d/20-envsubst-on-templates.sh renders this into
# /etc/nginx/conf.d/default.conf on container start, substituting only
# variables that are actually set in the environment (nginx's own $uri/$host
# etc. are untouched since they aren't env vars).
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Compress text-based responses. text/html is compressed by default and
    # is intentionally not listed in gzip_types.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Vite emits content-hashed filenames under /assets/, so they can be
    # cached forever. A changed file gets a new name, so stale copies can't
    # be served.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html references the hashed assets and must always be revalidated
    # so new deploys are picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # A client-side router (react-router) owns every non-asset path — any
    # unmatched request falls back to index.html rather than nginx's 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        default_type text/plain;
        return 200 'ok';
    }
}
