# Copy to apps/api/.env. Ports match docker-compose.yml's host mappings.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sc:sc@localhost:5433/sc_dev
REDIS_URL=redis://localhost:6380
# Must point at persistent storage in production (the admin dashboard links to
# these files; an ephemeral container filesystem would lose them on restart).
UPLOAD_DIR=uploads
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_PEPPER=replace-me-with-at-least-32-random-characters
AUTH_DEV_OTP=000000
COIN_USD_CENTS=50
CASH_OUT_MIN_USD_CENTS=500

# Admin console (apps/admin) — deliberately separate secrets from the JWT_*
# pair above so an admin session can never be forged from a user session.
ADMIN_JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
ADMIN_JWT_REFRESH_PEPPER=replace-me-with-at-least-32-random-characters
ADMIN_WEB_ORIGIN=http://localhost:5173

# Production verification: Infobip sends a WhatsApp template message first and
# retries SMS if WhatsApp delivery fails. Keep AUTH_DEV_OTP only for local
# development. INFOBIP_BASE_URL is the bare host from the Infobip dashboard
# (no scheme). The WhatsApp sender and template name must already exist —
# and the template be pre-approved — in the Infobip account.
INFOBIP_API_KEY=replace-with-infobip-api-key
INFOBIP_BASE_URL=xxxxx.api.infobip.com
INFOBIP_WHATSAPP_SENDER=replace-with-whatsapp-sender-number
INFOBIP_WHATSAPP_TEMPLATE_NAME=replace-with-approved-template-name
INFOBIP_SMS_SENDER=
INFOBIP_DEFAULT_CHANNEL=whatsapp

# Selected payment provider. These are validated in production. Do not switch
# PAYMENT_PROVIDER from fake until the Paynow checkout/refund model is chosen.
PAYMENT_PROVIDER=fake
PAYNOW_INTEGRATION_ID=replace-with-paynow-integration-id
PAYNOW_INTEGRATION_KEY=replace-with-paynow-integration-key
PAYNOW_RETURN_URL=https://api.example.com/v1/payments/paynow/return
PAYNOW_RESULT_URL=https://api.example.com/v1/payments/paynow/callback
