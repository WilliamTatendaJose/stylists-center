# Copy to apps/api/.env. Ports match docker-compose.yml's host mappings.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sc:sc@localhost:5433/sc_dev
REDIS_URL=redis://localhost:6380
# Must point at persistent storage in production (the admin dashboard links to
# these files; an ephemeral container filesystem would lose them on restart).
UPLOAD_DIR=uploads
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_PEPPER=replace-me-with-at-least-32-random-characters
COIN_USD_CENTS=50
# Commission paid to the referring agent after the first completed booking.
REFERRAL_REWARD_COINS=6
CASH_OUT_MIN_USD_CENTS=500

# Admin console (apps/admin) — deliberately separate secrets from the JWT_*
# pair above so an admin session can never be forged from a user session.
ADMIN_JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
ADMIN_JWT_REFRESH_PEPPER=replace-me-with-at-least-32-random-characters
ADMIN_WEB_ORIGIN=http://localhost:5173

# The project ID verifies signature, issuer, audience and expiry using Google's
# public signing certificates. The service-account fields are optional; set
# both to additionally reject Firebase-revoked/disabled sessions at exchange.
# Keep literal \\n separators when storing the private key in Railway.
FIREBASE_PROJECT_ID=style-center-5162a
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Selected payment provider. These are validated in production. Paynow's test
# integration IDs reject transactions that include an email field, so the
# checkout request must never add one (see paynow.adapter.ts). Defaults to
# fake here since not every environment has a Paynow account; set to paynow
# and fill in real values below to test against Paynow.
PAYMENT_PROVIDER=fake
PAYNOW_INTEGRATION_ID=replace-with-paynow-integration-id
PAYNOW_INTEGRATION_KEY=replace-with-paynow-integration-key
PAYNOW_RETURN_URL=https://api.example.com/v1/payments/paynow/return
PAYNOW_RESULT_URL=https://api.example.com/v1/payments/paynow/callback
# Required for bookings' EcoCash phone-prompt checkout (Express Checkout). In
# test mode this must equal one of the merchant account's own login emails.
PAYNOW_AUTH_EMAIL=replace-with-paynow-account-login-email
