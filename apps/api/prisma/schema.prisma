generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 moved the connection URL out of the schema entirely: migrations
// read it from prisma.config.ts, and PrismaClient takes a driver `adapter`
// at construction (see PrismaService) instead of reading DATABASE_URL itself.
// This block only declares which SQL dialect to generate types for.
datasource db {
  provider = "postgresql"
}

enum ActiveRole {
  client
  provider
}

enum VerificationStatus {
  unverified
  pending
  verified
}

/// Mirrors @sc/shared's PaymentMethod exactly — never drift these two.
enum PaymentMethod {
  ecocash
  cash
}

/// Mirrors @sc/shared's BookingStatus exactly.
enum BookingStatus {
  awaiting_provider
  confirmed
  completed
  declined
  cancelled
}

/// Mirrors @sc/shared's MatchState exactly (domain/match.ts's canTransition table).
enum MatchState {
  pending
  offered
  accepted
  confirmed
  expired
  declined
  no_show
}

enum BudgetMode {
  flex
  fixed
}

/// Mirrors @sc/shared's ReportReason exactly.
enum ReportReason {
  no_show
  misconduct
  safety
  other
}

enum ReportStatus {
  open
  reviewing
  resolved
}

enum BanTrigger {
  automatic
  manual
}

enum AppealStatus {
  none
  requested
  upheld
  overturned
}

/// Mirrors @sc/shared's referralStatusSchema exactly.
enum ReferralStatus {
  pending
  paid
}

enum WalletTxnType {
  referral_coin
  cash_out
  adjustment
}

/// Mirrors @sc/shared's ProviderProfileDto priceDisplay field exactly.
enum PriceDisplay {
  list
  from
}

/// A city-scoped deployment boundary (plan §6 multi-city NFR) — every geo
/// query is scoped by cityId AND radius, so a future second city can't leak
/// into another's search results by a shared coordinate space alone.
model City {
  id          String   @id @default(uuid())
  name        String
  timezone    String
  centroidLat Float
  centroidLng Float
  bboxWest    Float
  bboxSouth   Float
  bboxEast    Float
  bboxNorth   Float
  createdAt   DateTime @default(now())

  users     User[]
  providers ProviderProfile[]

  @@index([name])
}

/// Base identity. Firebase owns credentials; this row owns app authorization. `tokenVersion`
/// is bumped on a ban so every live session's JWT is invalidated instantly
/// without needing a revocation list lookup per request.
model User {
  id                         String             @id @default(uuid())
  firebaseUid                String?            @unique
  email                      String?            @unique
  phone                      String?            @unique
  displayName                String
  /// Client-controlled photo used for their identity in stylist jobs and messages.
  avatarImageUrl             String?
  activeRole                 ActiveRole         @default(client)
  /// Chosen after Firebase authentication. Null means this account has not yet
  /// selected which onboarding path to enter; activeRole is not consulted yet.
  selectedAccountType        ActiveRole?
  /// Set only after client details or stylist setup is finished.
  onboardingCompletedAt      DateTime?
  verificationStatus         VerificationStatus @default(unverified)
  verificationIdDocumentUrl  String?
  verificationSelfieImageUrl String?
  verificationNote           String?
  verificationSubmittedAt    DateTime?
  tokenVersion               Int                @default(0)
  bookingRemindersEnabled    Boolean            @default(true)
  pickupRemindersEnabled     Boolean            @default(true)
  /// Set by the admin console when access is suspended. Firebase is disabled
  /// at the same time, while this database flag invalidates app JWTs immediately.
  disabledAt                 DateTime?
  /// Tombstone rather than a hard delete: financial, booking and audit foreign
  /// keys remain valid, while credentials and personal fields are removed.
  deletedAt                  DateTime?
  cityId                     String
  city                       City               @relation(fields: [cityId], references: [id])
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  providerProfile ProviderProfile?
  agent           Agent?
  referralRecord  Referral?        @relation("ReferralReferredUser")

  matchRequests       MatchRequest[]
  bookingsAsClient    Booking[]           @relation("BookingClient")
  reviewsGiven        Review[]            @relation("ReviewRater")
  reviewsReceived     Review[]            @relation("ReviewRatee")
  reportsFiled        Report[]            @relation("ReportReporter")
  reportsReceived     Report[]            @relation("ReportReported")
  noShowRecords       NoShowRecord[]
  bans                Ban[]
  conversationsAsA    Conversation[]      @relation("ConversationClient")
  conversationsAsB    Conversation[]      @relation("ConversationProvider")
  messages            Message[]
  walletTransactions  WalletTransaction[]
  refreshTokenRecords RefreshToken[]
  auditLogEntries     AuditLog[]
  ordersAsBuyer       Order[]             @relation("OrderBuyer")
  productReviews      ProductReview[]
  pushTokens          DevicePushToken[]

  @@index([cityId])
  @@index([deletedAt])
}

/// One row per user who has completed provider onboarding. `salonCreatedAt`
/// feeds the 30-day new-salon-visibility cap (SRS §7 risk table); NULL for
/// an individual (non-salon) provider, where that cap doesn't apply.
///
/// `latitude`/`longitude` are the only geo columns Prisma manages — the
/// generated `location geography(Point,4326)` column and its GIST index are
/// added by a hand-written migration (plan §6) precisely so the app can never
/// write a `location` that disagrees with these two decimals.
model ProviderProfile {
  id                        String       @id @default(uuid())
  userId                    String       @unique
  user                      User         @relation(fields: [userId], references: [id])
  displayName               String
  tint                      String
  initials                  String
  categoryId                String
  category                  Category     @relation(fields: [categoryId], references: [id])
  areaName                  String
  latitude                  Float
  longitude                 Float
  cityId                    String
  city                      City         @relation(fields: [cityId], references: [id])
  yearsExperience           Int          @default(0)
  profileImageUrl           String?
  portfolioImageUrls        String[]     @default([])
  priceDisplay              PriceDisplay @default(list)
  fromPriceUsdCents         Int?
  workingHoursLabel         String
  /// The stylist's own mobile money number (E.164), shown on their public page so clients can pay them directly. Null until they add one.
  paymentPhone              String?
  /// Null preserves legacy profiles until the stylist configures a weekly calendar.
  weeklyHours               Json?
  /**
   * Provider-controlled "I'm taking work right now". The only thing that makes Home's "Available now" list actually mean anything.
   */
  acceptingBookings         Boolean      @default(true)
  verified                  Boolean      @default(false)
  /// False for a vendor-only profile (a shop that is not a stylist): searches
  /// and smart match skip it, but it still owns products and orders.
  offersServices            Boolean      @default(true)
  ratingAvg                 Float        @default(0)
  completedCount            Int          @default(0)
  salonCreatedAt            DateTime?
  /// Per-provider so a future admin webapp can change one provider's price
  /// without a deploy — see DEFAULT_SUBSCRIPTION_PRICE_USD_CENTS in @sc/shared.
  subscriptionPriceUsdCents Int          @default(500)
  /// Null for a provider who has never paid — never active, not an error.
  /// Whether that reads as "active" is computed from this at request time
  /// (isSubscriptionActive in @sc/shared), never stored as a separate flag,
  /// so it can never drift out of sync with the date it's derived from.
  subscriptionPaidUntil     DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  services             Service[]
  offers               MatchOffer[]
  bookings             Booking[]
  timeOff              ProviderTimeOff[]
  trips                Trip[]
  products             Product[]
  orders               Order[]
  subscriptionPayments Payment[]          @relation("SubscriptionPayments")
  payouts              Payout[]
  // The trigram (GIN) and partial availability indexes are declared in the
  // hand-written migration — Prisma's schema language cannot express either.
  feeLedgerEntries     FeeLedgerEntry[]
  vendor               VendorApplication?

  @@index([categoryId])
  @@index([cityId])
}

model ProviderTimeOff {
  id         String          @id @default(uuid())
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  note       String?         @db.VarChar(120)
  createdAt  DateTime        @default(now())

  @@index([providerId, startsAt, endsAt])
}

model Service {
  id              String          @id @default(uuid())
  providerId      String
  provider        ProviderProfile @relation(fields: [providerId], references: [id])
  name            String
  durationMinutes Int
  priceUsdCents   Int
  imageUrls       String[]        @default([])
  createdAt       DateTime        @default(now())

  bookings Booking[]

  @@index([providerId])
}

/// Self-referencing for a future hierarchical taxonomy (SRS §5.4); flat for
/// every M1 category.
model Category {
  id       String     @id @default(uuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  providers ProviderProfile[]
  matches   MatchRequest[]

  @@index([parentId])
}

/// A client's smart-match search. `radiusKm` starts at whatever the client
/// chose and widens geometrically on retry (see MATCH_RADIUS_GROWTH_FACTOR);
/// the server recomputes and rejects a client-supplied value that disagrees
/// (plan §6) — this column just records what was actually used.
model MatchRequest {
  id                   String     @id @default(uuid())
  clientId             String
  client               User       @relation(fields: [clientId], references: [id])
  categoryId           String
  category             Category   @relation(fields: [categoryId], references: [id])
  budgetMode           BudgetMode
  budgetAmountUsdCents Int?
  radiusKm             Int
  /// The client's location at request time — stored so a retry can re-run
  /// the fan-out at the next radius without the client resending it.
  latitude             Float
  longitude            Float
  state                MatchState @default(pending)
  attempt              Int        @default(1)
  expiresAt            DateTime
  fanOutCount          Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  offers   MatchOffer[]
  bookings Booking[]

  @@index([clientId])
  @@index([state])
}

/// One row per provider fanned out to for a MatchRequest. `respondBy` is the
/// per-offer 30s answer window (plan §6, OFFER_RESPONSE_TTL_SECONDS).
model MatchOffer {
  id             String          @id @default(uuid())
  matchRequestId String
  matchRequest   MatchRequest    @relation(fields: [matchRequestId], references: [id])
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id])
  state          MatchState      @default(offered)
  quoteUsdCents  Int
  respondBy      DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([matchRequestId, providerId])
  @@index([matchRequestId])
  @@index([providerId])
}

/// `reference` is the client-facing "SC-4471" code (formatBookingReference in
/// @sc/shared). Cash bookings sit in `confirmed` until both confirmation
/// flags are true (needsCashReconciliation in @sc/shared) — that double
/// confirmation is the only signal the platform has that a cash booking
/// happened at all.
model Booking {
  id                  String          @id @default(uuid())
  reference           String          @unique
  clientId            String
  client              User            @relation("BookingClient", fields: [clientId], references: [id])
  providerId          String
  provider            ProviderProfile @relation(fields: [providerId], references: [id])
  serviceId           String
  service             Service         @relation(fields: [serviceId], references: [id])
  matchRequestId      String?
  matchRequest        MatchRequest?   @relation(fields: [matchRequestId], references: [id])
  startsAt            DateTime
  /// Fixed at booking time from the selected service duration. This makes the
  /// appointment range auditable even if the service menu changes later.
  endsAt              DateTime
  paymentMethod       PaymentMethod
  status              BookingStatus   @default(awaiting_provider)
  priceUsdCents       Int
  confirmedByClient   Boolean         @default(false)
  confirmedByProvider Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  payments Payment[]
  reviews  Review[]
  reports  Report[]
  trips    Trip[]

  @@index([clientId])
  @@index([providerId])
  @@index([status])
}

/// Append-only escrow ledger (plan §6). Never mutate a row in place — a
/// refund or release is a NEW row referencing the same booking, not an
/// update, so the ledger stays a true audit trail.
model Payment {
  id                     String           @id @default(uuid())
  /// Exactly one of bookingId/orderId/subscriptionProviderId is set — the ledger covers all three money flows so it reconciles in one place. `feeUsdCents` is always 0 for a subscription row (there is no counterparty to take a cut from); it stays on the row rather than a separate model because the ledger's shape — provider/status/amount/externalRef/createdAt — is otherwise identical.
  bookingId              String?
  booking                Booking?         @relation(fields: [bookingId], references: [id])
  orderId                String?
  order                  Order?           @relation(fields: [orderId], references: [id])
  subscriptionProviderId String?
  subscriptionProvider   ProviderProfile? @relation("SubscriptionPayments", fields: [subscriptionProviderId], references: [id])
  provider               String // 'fake-ecocash' | 'paynow' | 'pesepay' — a string, not an enum, so a further gateway is a new value, not a migration
  status                 String // held | released | refunded | failed
  amountUsdCents         Int
  feeUsdCents            Int              @default(0)
  externalRef            String?
  /// The gateway reference this payment was initiated under. Bookings and orders carry their own `reference` column, but a subscription has no such row — without this, a Paynow callback for a subscription had nothing to match against and was rejected as unknown. Nullable because rows written before this column existed cannot be backfilled.
  reference              String?
  /// Which wallet or card paid ('ecocash' | 'onemoney' | 'innbucks' | 'omari' | 'card'). A string for the same reason `provider` is; null on rows written before channels existed (all EcoCash) and on fake/internal rows.
  channel                String?
  /// Where an O'mari one-time code must be posted (Paynow's `remoteotpurl`). Server-only — never sent to a client.
  otpUrl                 String?
  createdAt              DateTime         @default(now())

  @@index([bookingId])
  @@index([orderId])
  @@index([subscriptionProviderId])
  @@index([reference])
}

/// `Payment.status = 'released'` only marks escrow as settled inside this
/// ledger — nothing in this codebase actually moves money to a provider
/// (see PaymentGatewayPort: createCheckout/verifyCallback, no
/// transfer/payout method). A Payout row is an admin's attestation that a
/// real-world transfer (bank, mobile money, cash) happened outside the app;
/// it doesn't touch Payment, so the escrow ledger and the "did we actually
/// pay them" record stay two honest, separately-auditable things. Append-only
/// like Payment, for the same audit-trail reason.
model Payout {
  id             String          @id @default(uuid())
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id])
  amountUsdCents Int
  note           String?
  createdAt      DateTime        @default(now())

  @@index([providerId])
}

/// Mirrors @sc/shared's OrderStatus exactly.
enum OrderStatus {
  /// Stock held for the buyer; the buyer pays the vendor on delivery or collection.
  reserved
  /// Seller says the goods are packed, for a collection order.
  ready_for_collection
  /// Seller has sent a delivery order on its way.
  out_for_delivery
  /// Handed over at the shop. Completed: the vendor owes commission.
  collected
  /// Handed over at the buyer's address. Completed: the vendor owes commission.
  delivered
  cancelled
}

enum FulfilmentMethod {
  collection
  delivery
}

enum VendorStatus {
  pending
  approved
  rejected
}

/// A physical item a stylist sells — hair, wigs, nail supplies, cosmetics.
model Product {
  id            String          @id @default(uuid())
  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id])
  name          String
  description   String
  category      String          @default("other")
  priceUsdCents Int
  /// Authoritative stock. Reserved atomically at checkout, restored on cancellation.
  stockQty      Int             @default(0)
  version       Int             @default(0)
  imageUrls     String[]        @default([])
  /// A delisted product stays for order history; it just stops being sellable.
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  orderItems     OrderItem[]
  productReviews ProductReview[]

  @@index([providerId])
  @@index([active])
}

/// One order is always with ONE stylist — the buyer collects from a single place.
model Order {
  id                     String           @id @default(uuid())
  reference              String           @unique
  buyerId                String
  buyer                  User             @relation("OrderBuyer", fields: [buyerId], references: [id])
  providerId             String
  provider               ProviderProfile  @relation(fields: [providerId], references: [id])
  status                 OrderStatus      @default(reserved)
  paymentMethod          PaymentMethod
  /// Buyer-scoped request key: retrying a timed-out checkout returns the same order.
  checkoutKey            String?
  checkoutFingerprint    String?
  checkoutUrl            String?
  checkoutInstructions   String?
  pickupAddress          String?
  pickupHours            String?
  pickupLat              Float?
  pickupLng              Float?
  pickupNote             String?
  fulfilment             FulfilmentMethod @default(collection)
  deliveryAddress        String?
  /// Kept apart from totalUsdCents: the commission is on the product total only.
  deliveryChargeUsdCents Int              @default(0)
  /// Coins the buyer spent on this order and what they were worth at the time.
  coinsUsed              Int              @default(0)
  coinsValueUsdCents     Int              @default(0)
  /// When the order was delivered or collected.
  completedAt            DateTime?
  /// Sum of the item snapshots (products only, no delivery), stored so a later price change cannot rewrite history.
  totalUsdCents          Int
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  items          OrderItem[]
  payments       Payment[]
  productReviews ProductReview[]

  @@unique([buyerId, checkoutKey])
  @@index([buyerId])
  @@index([providerId])
}

/// A shop's application to sell, one per ProviderProfile. Only an approved
/// one may list products or take orders; the vendor's delivery and collection
/// defaults live here too.
model VendorApplication {
  id                     String          @id @default(uuid())
  providerId             String          @unique
  provider               ProviderProfile @relation(fields: [providerId], references: [id])
  businessName           String
  registrationNumber     String?
  shopAddress            String
  shopLat                Float?
  shopLng                Float?
  premisesPhotoUrls      String[]        @default([])
  contactName            String
  contactPhone           String
  status                 VendorStatus    @default(pending)
  /// Plain id, no foreign key: staff accounts are never hard-deleted, and this keeps AdminUser untouched.
  reviewedByAdminId      String?
  reviewNote             String?
  reviewedAt             DateTime?
  submittedAt            DateTime        @default(now())
  /// Delivery and collection defaults, set by the vendor once approved.
  delivers               Boolean         @default(false)
  deliveryChargeUsdCents Int             @default(0)
  deliveryAreas          String[]        @default([])
  collectionAddress      String?
  collectionHours        String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([status, submittedAt])
}

/// Name and price are snapshotted: what the buyer agreed to pay must not move when the seller edits the product.
model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  nameSnapshot  String
  priceUsdCents Int
  quantity      Int

  @@index([orderId])
}

/// A product rating can only come from a buyer after collecting that product.
model ProductReview {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  rating    Int
  text      String?
  createdAt DateTime @default(now())

  @@unique([orderId, productId])
  @@index([productId, createdAt])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  raterId   String
  rater     User     @relation("ReviewRater", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("ReviewRatee", fields: [rateeId], references: [id])
  rating    Int
  text      String?
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([rateeId])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id])
  reportedId     String
  reported       User         @relation("ReportReported", fields: [reportedId], references: [id])
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  reason         ReportReason
  status         ReportStatus @default(open)
  /// Set by the admin console when a report moves to `resolved` — the record of why.
  resolutionNote String?
  createdAt      DateTime     @default(now())

  @@index([reportedId])
}

/// Counts toward the 5-strike automatic ban (trust.ts NO_SHOW_COUNT_FOR_AUTO_BAN)
/// independent of admin review — a counted fact, not a judgement call.
model NoShowRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookingId String
  /**
   * 'no_show' | 'late_cancellation' — both count toward account standing, but an appeal needs to know which happened.
   */
  reason    String   @default("no_show")
  createdAt DateTime @default(now())

  @@unique([userId, bookingId, reason])
  @@index([userId])
  @@index([userId, createdAt])
}

model Ban {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  reason       String
  trigger      BanTrigger
  appealStatus AppealStatus @default(none)
  /// The admin console's rationale for the current appealStatus — set whenever an appeal is upheld or overturned.
  appealNote   String?
  createdAt    DateTime     @default(now())

  @@index([userId])
}

/// One conversation per client/provider pair — the handoff's chat model is
/// strictly 1:1, not a group thread.
model Conversation {
  id                 String   @id @default(uuid())
  clientId           String
  client             User     @relation("ConversationClient", fields: [clientId], references: [id])
  providerUserId     String
  providerUser       User     @relation("ConversationProvider", fields: [providerUserId], references: [id])
  lastMessageAt      DateTime @default(now())
  /// Only the client role exists in M1 (Provider screens are a later
  /// milestone), so this is the one read-receipt column needed: unreadCount
  /// on the client's own inbox is just "messages from the provider after
  /// this timestamp", bumped whenever the client fetches the thread.
  clientLastReadAt   DateTime @default(now())
  providerLastReadAt DateTime @default(now())
  createdAt          DateTime @default(now())

  messages Message[]

  @@unique([clientId, providerUserId])
  @@index([lastMessageAt])
  // The unique above only serves clientId-led lookups; the provider's inbox filters on providerUserId.
  @@index([providerUserId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  text           String
  createdAt      DateTime     @default(now())

  attachments MessageAttachment[]

  // Serves both the latest-page/cursor reads and the unread-count aggregation.
  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  name      String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([messageId])
}

/// A verified agent's referral identity. `status` gates whether the agent is
/// currently allowed to earn (SRS §7: fraud mitigation can suspend an agent
/// without deleting their history).
model Agent {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  referralCode       String             @unique
  verificationStatus VerificationStatus @default(unverified)
  status             String             @default("active") // active | suspended
  createdAt          DateTime           @default(now())

  referrals Referral[]
}

model Referral {
  id             String         @id @default(uuid())
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id])
  referredName   String
  referredUserId String?        @unique
  referredUser   User?          @relation("ReferralReferredUser", fields: [referredUserId], references: [id])
  coinsAwarded   Int
  status         ReferralStatus @default(pending)
  createdAt      DateTime       @default(now())

  @@index([agentId])
}

/// Every coin movement, in and out — cash-out unlocks once the sum for a
/// user exceeds CASH_OUT_MIN_USD_CENTS (@sc/shared/domain/money.ts).
model WalletTransaction {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  type      WalletTxnType
  coins     Int
  usdCents  Int
  reference String?
  createdAt DateTime      @default(now())

  cashOutSettlement CashOutSettlement?

  @@index([userId])
}

/// A cash-out request (WalletTransaction.type = 'cash_out') already debited
/// the coin ledger the moment it was requested — nothing in this codebase
/// actually moves real money to a stylist. This row is an admin's attestation
/// that the real-world transfer (EcoCash, cash, bank) happened, the same
/// relationship Payout has to Payment: it never touches WalletTransaction,
/// so the ledger and "did we actually pay them" stay two honest,
/// separately-auditable things. One row per settled cash-out (existence = paid).
model CashOutSettlement {
  id                  String            @id @default(uuid())
  walletTransactionId String            @unique
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id])
  note                String?
  createdAt           DateTime          @default(now())
}

/// Live trip state (plan risk R8 — Data Protection Act). Deliberately holds
/// only the LATEST position, never a track history, and hard-terminates on
/// check-in; foreground-only on the client, which is also what keeps this
/// out of the Play Store's background-location policy review.
model Trip {
  id          String          @id @default(uuid())
  bookingId   String
  booking     Booking         @relation(fields: [bookingId], references: [id])
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id])
  mode        String // 'client' | 'provider'
  lastLat     Float?
  lastLng     Float?
  arrived     Boolean         @default(false)
  etaSharedAt DateTime?
  checkedInAt DateTime?
  startedAt   DateTime        @default(now())

  @@index([bookingId])
}

/// Rotated on every refresh-token use, with reuse detection (plan §6): a
/// replayed token revokes the whole family by deleting every row sharing
/// `familyId`.
/// One Expo Push Token per install. A token can move between accounts when a
/// device is handed over, so it is globally unique and upserted on every app launch.
model DevicePushToken {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  expoPushToken String   @unique
  platform      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  familyId  String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
}

/// Append-only audit trail (SRS NFR: "all admin actions logged with actor and
/// timestamp"). Written by a global interceptor, never mutated after insert.
/// `actorId`/`adminActorId` are mutually exclusive — a request is either a
/// signed-in user's or a staff member's, never both.
model AuditLog {
  id           String     @id @default(uuid())
  actorId      String?
  actor        User?      @relation(fields: [actorId], references: [id])
  adminActorId String?
  adminActor   AdminUser? @relation(fields: [adminActorId], references: [id])
  action       String
  targetType   String?
  targetId     String?
  ip           String?
  at           DateTime   @default(now())

  @@index([actorId])
  @@index([adminActorId])
  @@index([at])
}

/// Staff identity for the admin console — deliberately separate from `User`
/// (email + password, not phone + OTP): staff aren't clients or providers,
/// and the two login flows should never be able to authenticate as each
/// other by construction, not just by convention.
/// What an admin may do in the console. Owners can do everything; see
/// admin-auth/admin-roles.ts for which areas finance and support can reach.
enum AdminRole {
  owner
  finance
  support
}

model AdminUser {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  displayName        String
  role               AdminRole @default(support)
  /// Same lever as User.tokenVersion: bump to invalidate every live admin session instantly (disabling a staff account).
  tokenVersion       Int       @default(0)
  /// A revoked staff account — kept rather than deleted so AuditLog.adminActor
  /// stays resolvable for their past actions. Checked at login and on every
  /// access-token verification, so revocation takes effect immediately.
  disabled           Boolean   @default(false)
  /// Deleted accounts stay in the database so historical audit actors remain resolvable.
  deletedAt          DateTime?
  /// Encrypted TOTP secret (admin-auth/secret-box.ts); set once 2FA is confirmed.
  totpSecret         String?
  /// Encrypted secret awaiting its first valid code during enrolment.
  totpPendingSecret  String?
  totpEnabledAt      DateTime?
  /// Last TOTP time-step accepted, so a code can't be replayed inside its window.
  totpLastUsedStep   Int?
  /// SHA-256 hashes of unused one-time recovery codes.
  recoveryCodeHashes String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens   AdminRefreshToken[]
  auditLogEntries AuditLog[]

  @@index([email])
  @@index([deletedAt])
}

/// Mirrors RefreshToken's rotation-with-reuse-detection scheme exactly, kept
/// as a separate table so an admin session can never be confused with (or
/// forged from) a user session's refresh token.
model AdminRefreshToken {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  familyId    String
  tokenHash   String    @unique
  revoked     Boolean   @default(false)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([familyId])
}

/// A business value saved by staff in the admin console (Settings page).
/// Keys and allowed ranges live in @sc/shared SETTING_DEFINITIONS; a row here
/// overrides the matching environment variable and the built-in default.
/// Deleting the row ("Reset" in the console) puts those back in effect.
model PlatformSetting {
  key              String   @id
  /// A number or a string, already validated against the definition.
  value            Json
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}

/// Terms and privacy text edited by staff in the admin console (Content
/// page). Keys live in @sc/shared CONTENT_KEYS; a key with no row shows the
/// built-in placeholder.
model ContentDocument {
  key              String   @id
  title            String
  body             String
  /// Starts at 1 on the first save and goes up by one on every save.
  version          Int      @default(1)
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}

/// What a fee ledger row records.
enum FeeEntryKind {
  /// Service fee on a completed booking (owed by the stylist).
  booking_fee
  /// Commission on a delivered or collected marketplace order (owed by the vendor).
  order_fee
  /// A fee taken back: a reported non-payment, or a cancelled charge.
  waiver
  /// Money paid towards the balance (through the app or recorded by staff).
  payment
  /// A manual correction by staff, either direction.
  adjustment
}

/// What each stylist or vendor owes StylistsCenter. Clients pay stylists and
/// vendors directly, so the app keeps this running balance instead of
/// splitting payments. Append-only: a reversal is a new `waiver` row, never
/// an edit. Positive amounts are owed; negative amounts are paid or credited.
/// The balance is the sum of `amountUsdCents` for a provider.
model FeeLedgerEntry {
  id               String          @id @default(uuid())
  providerId       String
  provider         ProviderProfile @relation(fields: [providerId], references: [id])
  kind             FeeEntryKind
  amountUsdCents   Int
  /// What the fee was charged on (job price or product total), for statements.
  baseUsdCents     Int?
  /// The rate used, in basis points, so a statement shows it even after the setting changes.
  rateBps          Int?
  bookingId        String?
  orderId          String?
  /// For `payment` rows made through the app: the gateway Payment row.
  paymentId        String?
  note             String?
  createdByAdminId String?
  createdAt        DateTime        @default(now())

  // One charge and at most one waiver per booking or order, so retries and
  // races can never double-charge. Postgres treats NULLs as distinct, so
  // rows without a booking/order are unaffected.
  @@unique([kind, bookingId])
  @@unique([kind, orderId])
  @@index([providerId, createdAt])
}
