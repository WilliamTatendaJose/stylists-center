# Expo's Metro resolver does not follow pnpm's symlinked node_modules reliably.
# A hoisted linker plus metro.config.js `watchFolders: [workspaceRoot]` is the
# known-good combination for Expo in a pnpm monorepo. Changing this will break
# the mobile app's bundling in ways that look like missing-module errors.
node-linker=hoisted

# Keep peer resolution strict so RN/Expo version mismatches surface at install
# time rather than as a runtime crash on device.
strict-peer-dependencies=false
auto-install-peers=true
