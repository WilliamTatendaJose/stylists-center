{
  "name": "stylists-center",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "pnpm --filter @sc/api db:reset",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "pnpm": {
    "overrides": {
      "react-native-worklets": "0.10.3",
      "proxy-addr@<2.0.8": "^2.0.8",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "qs@>=6.7.0 <6.16.1": "^6.16.1",
      "multer@<2.5.0": "^2.5.0",
      "engine.io@>=6.6.0 <6.6.10": "^6.6.10",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "^1.14.5",
      "fast-xml-parser@>=5.0.0 <5.12.0": "^5.12.0",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "@scarf/scarf",
      "@swc/core"
    ]
  }
}
