# ---------------------------------------------------------------------------
# API  (apps/api/.env)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Ports match docker-compose.yml's host mappings, not the container defaults.
DATABASE_URL=postgresql://sc:sc@localhost:5433/sc_dev
REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_PEPPER=replace-me-with-at-least-32-random-characters

# Development only. Env validation rejects this in production, so a real SMS or
# WhatsApp provider must be wired before going live.
AUTH_DEV_OTP=000000

# Production verification: Infobip sends a WhatsApp template message first and
# retries SMS if WhatsApp delivery fails. Keep AUTH_DEV_OTP only for local
# development. INFOBIP_BASE_URL is the bare host from the Infobip dashboard
# (no scheme). The WhatsApp sender and template name must already exist —
# and the template be pre-approved — in the Infobip account.
INFOBIP_API_KEY=replace-me-with-a-real-infobip-api-key
INFOBIP_BASE_URL=replace-me-with-your-infobip-base-url
INFOBIP_WHATSAPP_SENDER=replace-me-with-a-real-whatsapp-sender-number
INFOBIP_WHATSAPP_TEMPLATE_NAME=replace-me-with-an-approved-template-name
INFOBIP_SMS_SENDER=
INFOBIP_DEFAULT_CHANNEL=whatsapp

# Paynow credentials. Production validation requires these with
# PAYMENT_PROVIDER=fake; do not put them in the mobile environment.
PAYMENT_PROVIDER=fake
PAYNOW_INTEGRATION_ID=replace-me-with-a-real-paynow-integration-id
PAYNOW_INTEGRATION_KEY=replace-me-with-a-real-paynow-integration-key
PAYNOW_RETURN_URL=https://api.example.com/v1/payments/paynow/return
PAYNOW_RESULT_URL=https://api.example.com/v1/payments/paynow/callback

# Business constants. Kept in env so they are auditable and can be changed
# without a deploy, but they default to the values in the SRS. (The provider
# subscription price is per-provider — ProviderProfile.subscriptionPriceUsdCents,
# defaulting to $5/month — not an env var, since a future admin webapp needs
# to change one provider's price without a deploy.)
COIN_USD_CENTS=50
CASH_OUT_MIN_USD_CENTS=500

# ---------------------------------------------------------------------------
# Mobile  (apps/mobile/.env)
# EXPO_PUBLIC_* vars are baked into the JS bundle — never put a secret here.
# ---------------------------------------------------------------------------
# Leave unset in development: the app derives the API host from the Metro
# server, which works on a physical device over wifi with no configuration.
# Required in release builds.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000

# tile.openstreetmap.org is acceptable for development only. Its usage policy
# forbids bulk downloading, which is exactly what the offline tile pack does —
# a real tile vendor is required before launch (see plan risk R1).
# MapTiler key is safe to embed only when it is restricted by app/package and
# permitted domains in the MapTiler dashboard. The app falls back to OSM only
# in local development when this is absent.
EXPO_PUBLIC_MAPTILER_KEY=random-key-for-maptiler

# Required for Expo push tokens in EAS builds; this is the EAS project UUID,
# not a secret. FCM/APNs credentials are managed through EAS credentials.
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id

# 'maplibre' (default) or 'leaflet' for the Expo Go WebView fallback.
EXPO_PUBLIC_MAP_ENGINE=maplibre
